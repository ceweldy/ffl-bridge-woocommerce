{
    "name": "ceweldy/ffl-bridge-woocommerce",
    "description": "Server-verified FFL dealer selection for WooCommerce checkout.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude dist .",
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "test": "phpunit --configuration phpunit.xml.dist",
        "check": [
            "@lint",
            "@phpcs",
            "@test"
        ]
    },
    "support": {
        "issues": "https://github.com/ceweldy/ffl-bridge-woocommerce/issues",
        "source": "https://github.com/ceweldy/ffl-bridge-woocommerce"
    }
}
